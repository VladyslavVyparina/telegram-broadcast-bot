# Публічний бот (для користувачів з підпискою)
# Скопіюйте як .env.public і заповніть своїми даними

BOT_TOKEN=your_public_bot_token_here
ADMIN_ID=123456789
STARS_OWNER_ID=929743223
DEFAULT_LANGUAGE=ar
DATABASE_PATH=bot_public.db
BOT_TIMEZONE=Asia/Riyadh
PLATFORM_BOT_USERNAME=Ni_iF7Fibot
CRYPTO_ADMIN_USERNAME=sftsfdrtghbot

# Crypto Pay (@CryptoBot) — recommended for auto USDT/TON payments
# 1. Open @CryptoBot → Crypto Pay → Create App → copy API Token
# 2. In app settings → Webhooks → set URL (optional; polling works without domain)
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_TESTNET=0
CRYPTO_PAY_WEBHOOK_PATH=/crypto-pay/webhook
CRYPTO_PAY_RETURN_URL=https://t.me/Ni_iF7Fibot
CRYPTO_PAY_ORDER_TIMEOUT=3600

# Wallet Pay (optional alternative)
# API key — після верифікації в merchant panel (див. інструкцію в чаті)
WALLET_PAY_API_KEY=
# Webhook опційний: без домену бот сам перевіряє оплату кожні ~60 сек (polling)
WALLET_PAY_WEBHOOK_HOST=0.0.0.0
WALLET_PAY_WEBHOOK_PORT=8765
WALLET_PAY_WEBHOOK_PATH=/wallet-pay/webhook
WALLET_PAY_RETURN_URL=https://t.me/Ni_iF7Fibot
WALLET_PAY_ORDER_TIMEOUT=3600
